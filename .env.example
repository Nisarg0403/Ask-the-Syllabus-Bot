# ==============================================================================
# ASK-THE-SYLLABUS BOT — EXAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and adjust values for your local deployment.
# NEVER commit real secret API keys, tokens, or passwords to git.
# ==============================================================================

# Application & Server
APP_NAME="Ask-the-Syllabus Bot API"
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_TEMPERATURE=0.2

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG & Chunking Parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=4
RERANKER_MODEL_NAME=ms-marco-TinyBERT-L-2-v2
RERANKER_CANDIDATE_K=16
EVIDENCE_THRESHOLD=0.25

# Observability Settings
BACKGROUND_INGESTION_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID
